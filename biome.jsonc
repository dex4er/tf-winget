{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      // Rewritten by trunk upgrade
      "!**/.trunk",
      // Generated by make.sh
      "!**/manifests",
      "!**/winget-pkgs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "useEditorconfig": true
  },
  "yaml": {
    "formatter": {
      // An expression of GitHub Actions reads better on one line
      "lineWidth": 120
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "nursery": {
        // Markdown, where the rest of the rules of markdownlint are about
        // formatting, which the formatter does; not useTopLevelHeading, as
        // CLAUDE.md starts with the import of AGENTS.md
        "useConsistentHeadingLevel": "error",
        "useFencedCodeLanguage": "error",
        "useSingleTopLevelHeading": "error",
        // YAML, as key-duplicates of yamllint, which also sees a quoted and an
        // unquoted form of the same key as duplicates
        "noDuplicateMapKeys": "error"
      },
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      // The WinGet manifest templates keep the style of microsoft/winget-pkgs,
      // with CRLF and sequences not indented under their key, which Biome
      // cannot produce. make.sh formats the generated manifests with yamlfmt
      // and template/.yamlfmt.yaml instead; the linter still runs on them. The
      // leading **/ is needed, as Trunk runs Biome on a copy of the files
      // outside the repository.
      "includes": ["**/template/**"],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
